
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  SAMPLE_COLLECTED
  IN_PROGRESS
  RESULTS_READY
  COMPLETED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  WALLET
}

enum ReferralRewardStatus {
  PENDING    // booking paid, reward not yet available
  CONFIRMED  // booking completed, available for withdrawal
  PAID       // included in a completed withdrawal
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum ReferralType {
  USER
  ADMIN
  AGENT
}

enum AgentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?
  address       String?
  roleId        String
  role          CustomRole @relation(fields: [roleId], references: [id])
  referralCode          String    @unique
  referredByCode        String?
  emailVerified         Boolean   @default(false)
  emailUnsubscribed     Boolean   @default(false)
  unsubscribeToken      String?   @unique @default(cuid())
  isActive              Boolean   @default(true)
  mustChangePassword    Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  bookings              Booking[]
  transactions          Transaction[]
  cart                  Cart?
  referralRewardsGiven  ReferralReward[] @relation("ReferralRewardReferrer")
  referralRewardsEarned ReferralReward[] @relation("ReferralRewardReferee")
  emailVerifications    EmailVerification[]
  notifications         Notification[]
  passwordResets        PasswordReset[]
  bankAccount           AgentBankAccount?
  withdrawalRequests    WithdrawalRequest[]
  auditLogs             AuditLog[] @relation("AuditLogActor")
  emailJobs             EmailBroadcastJob[]
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String       @id @default(cuid())
  roleId       String
  role         CustomRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([roleId, permissionId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages    Package[]
}

model Test {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Decimal  @default(0.0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages    Package[]  @relation("PackageTests")
}

model Package {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  price       Decimal  @default(0.0) @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)

  // Relations
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  tests       Test[]   @relation("PackageTests")
  bookings    Booking[]
  promos      PromoPackage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])

  date            DateTime
  status          BookingStatus @default(PENDING)
  homeCollection  Boolean       @default(false)
  totalAmount     Decimal       @default(0.0) @db.Decimal(10, 2)
  paymentRef      String?       // Paystack reference — set on initialize, kept for audit
  referralCode    String?       // referral code used at checkout (if any)
  discountAmount  Decimal       @default(0.0) @db.Decimal(10, 2) // voucher discount applied to this line
  resultPdfUrl    String?
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
  referralRewards ReferralReward[]
  logs            BookingLog[]
}

model BookingLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event     String   // PAYMENT_CONFIRMED | STATUS_CHANGED | PDF_UPLOADED | BOOKING_CREATED
  note      String   // Human-readable: "Payment confirmed by Paystack"
  actorName String   // "Paystack", admin display name, "System"
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model Promo {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountType    String    // "PERCENTAGE" or "FIXED"
  discountValue   Decimal   @db.Decimal(10, 2)
  minAmount       Decimal?  @db.Decimal(10, 2)
  maxDiscount     Decimal?  @db.Decimal(10, 2)
  validFrom       DateTime
  validUntil      DateTime
  usageLimit      Int?
  usageCount      Int       @default(0)
  isActive        Boolean   @default(true)
  applyToAll      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  packages        PromoPackage[]
  transactions    Transaction[]
}

model PromoPackage {
  id        String   @id @default(cuid())
  promoId   String
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([promoId, packageId])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])

  bookingId       String
  booking         Booking           @relation(fields: [bookingId], references: [id])

  promoId         String?
  promo           Promo?            @relation(fields: [promoId], references: [id])

  amount          Decimal           @db.Decimal(10, 2)
  discount        Decimal           @default(0.0) @db.Decimal(10, 2)
  finalAmount     Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  status          TransactionStatus @default(PENDING)
  reference       String?           @unique
  metadata        String?           // JSON string for additional data

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ReferralReward {
  id         String               @id @default(cuid())
  referrerId String
  referrer   User                 @relation("ReferralRewardReferrer", fields: [referrerId], references: [id])
  refereeId  String
  referee    User                 @relation("ReferralRewardReferee", fields: [refereeId], references: [id])
  bookingId  String
  booking    Booking              @relation(fields: [bookingId], references: [id])
  amount        Decimal              @db.Decimal(10, 2)
  rewardPercent Decimal              @default(0) @db.Decimal(5, 2)  // e.g. 10.00 = 10%
  status        ReferralRewardStatus @default(PENDING)
  referralType  ReferralType         @default(USER)
  withdrawalId  String?
  withdrawal    WithdrawalRequest?   @relation(fields: [withdrawalId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // booking_confirmed | status_update | results_ready | new_booking
  title     String
  message   String
  bookingId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model AgentApplication {
  id          String                 @id @default(cuid())
  name        String
  email       String
  phone       String?
  city        String?
  motivation  String                 @db.Text
  status      AgentApplicationStatus @default(PENDING)
  adminNotes  String?
  userId      String?                // set when approved and account created
  createdAt   DateTime               @default(now())
  processedAt DateTime?
}

model AgentBankAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WithdrawalRequest {
  id                   String           @id @default(cuid())
  agentId              String
  agent                User             @relation(fields: [agentId], references: [id])
  amount               Decimal          @db.Decimal(10, 2)
  status               WithdrawalStatus @default(PENDING)
  paystackTransferCode String?
  paystackReference    String?
  failureReason        String?
  processedAt          DateTime?
  rewards              ReferralReward[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     String   @default("[]") // JSON: Package[]
  extras    String   @default("{}") // JSON: { voucherCode, appliedPromo, referralCode, appliedReferral }
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action       String   // e.g. "BOOKING_STATUS_UPDATE", "PACKAGE_CREATED", "ADMIN_DEACTIVATED"
  resource     String   // e.g. "Booking", "Package", "User"
  resourceId   String?
  resourceName String?  // Human-readable name: "Complete Blood Count", "john@example.com"
  detail       String?  // Free-form description of the change
  metadata     String?  // JSON: structured context, e.g. { "from": "PENDING", "to": "CONFIRMED", "price": 15000 }
  ip           String?  // Actor IP address
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model EmailBroadcastJob {
  id             String   @id @default(cuid())
  status         String   @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  subject        String
  htmlContent    String   @db.Text
  recipientType  String   // all | users | agents | admins | specific
  specificEmails String?  @db.Text // JSON array of email strings
  totalRecipients Int     @default(0)
  sent           Int      @default(0)
  failed         Int      @default(0)
  errorMessage   String?
  actorId        String
  actor          User     @relation(fields: [actorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([actorId])
}
